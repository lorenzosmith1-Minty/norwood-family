   uploadedAt: int;
   uploadedBy: principal;
 };
type PersonProfile = 
 record {
   birthDate: opt text;
   birthInfo: opt text;
   birthplace: opt text;
   claimStatus: ClaimStatus;
   claimedByUserId: opt principal;
   currentLocation: opt text;
   firstName: opt text;
   lastName: opt text;
   livingStatus: LivingStatus;
   longerStory: opt text;
   middleName: opt text;
   name: text;
   nickname: opt text;
   occupation: opt text;
   personId: PersonId;
   preferredName: opt text;
   privacySettings: opt text;
   shortBio: opt text;
   story: opt text;
   suffix: opt text;
   timeline: opt vec text;
 };
type PersonMatch = 
 record {
   name: text;
