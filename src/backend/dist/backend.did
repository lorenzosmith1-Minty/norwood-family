 };
type PersonId = text;
type NotificationType = 
 variant {
   ProfileClaimRequested;
   ProfileClaimReviewed;
   RelationshipRequested;
   RelationshipReviewed;
 };
type NotificationId = nat;
type Notification = 
 record {
   createdAt: int;
   id: nat;
   message: text;
   notificationType: NotificationType;
   read: bool;
   recipient: principal;
 };
type MergeResult = 
 record {
   archivedPersonId: PersonId;
   canonicalPersonId: PersonId;
   conflicts: vec MergeConflict;
 };
type MergeError = 
 variant {
   NotDuplicate;
   NotSignedIn;
   ProfileNotFound;
   SameProfile;
 };
type MergeConflictStatus = 
 variant {
   Pending;
   Resolved;
 };
type MergeConflict = 
 record {
   alternateValue: text;
   canonicalValue: text;
   field: text;
   id: nat;
   resolvedAt: opt int;
   resolvedBy: opt principal;
   status: MergeConflictStatus;
 };
type LivingStatus = 
 variant {
   Deceased;
   Living;
 };
type ExternalBlob = blob;
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type EditError = 
 variant {
   DeceasedProfile;
   NotOwner;
   NotSignedIn;
   ProfileNotFound;
 };
type DuplicatePair = 
 record {
   candidateA: DuplicateCandidate;
   candidateB: DuplicateCandidate;
 };
type DuplicateCandidate = 
 record {
   archiveLinks: vec text;
   birthDate: opt text;
   children: vec text;
   claimStatus: text;
   deathDate: opt text;
   name: text;
   ownerAccount: opt principal;
   parents: vec text;
   personId: PersonId;
   photoCount: nat;
   sourceCount: nat;
   spouses: vec text;
   timelineCount: nat;
 };
