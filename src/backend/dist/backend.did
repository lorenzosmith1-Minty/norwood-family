   reason: text;
   requestingUserId: principal;
   reviewedBy: opt principal;
   reviewedDate: opt int;
   status: ProfileRemovalStatus;
   submittedDate: int;
 };
type ProfileEdits = 
 record {
   birthDate: opt text;
   birthInfo: opt text;
   birthplace: opt text;
   currentLocation: opt text;
   firstName: opt text;
   lastName: opt text;
   livingStatus: opt LivingStatus;
