 };
service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result_18);
  _internet_identity_sign_in_start: () -> (blob);
  activateSuccessor: (personId: PersonId) -> (Result_8);
  addCanonicalStory: (title: text, storyText: text, relatedMemberIds:
   vec text, era: opt text, year: opt nat, location: opt text,
   evidenceStatus: EvidenceStatus, relatedArchiveItemIds: vec nat) -> (
   Story);
  addPhoto: (personId: PersonId, filename: text, mimeType: text, "blob":
   ExternalBlob) -> (Photo);
  addRelationship: (fromPersonId: PersonId, toPersonId: PersonId,
   relationshipType: RelationshipType) -> (Result_16);
  approveArchiveItem: (id: ArchiveItemId) -> (opt ArchiveItem);
  approveProfileClaim: (claimId: nat) -> (opt ProfileClaim);
  approveProfileRemoval: (requestId: nat) -> (opt ProfileRemovalRequest);
  approveRelationshipRequest: (requestId: nat) -> (opt RelationshipRequest);
  approveStory: (id: StoryId) -> (opt Story);
  archiveProfile: (personId: PersonId) -> (Result_1);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  bindAuthMethod: (method: AuthMethod) -> (Result_17);
  correctRelationshipType: (relationshipId: nat, relationshipType:
   RelationshipType) -> (Result_16);
  createCanonicalMystery: (title: text, description: text, relatedMemberIds:
   vec text, relatedBranchId: opt text, knownFacts: vec text, possibilities:
   vec text, relatedSourceIds: vec nat, relatedArchiveItemIds: vec nat,
   status: MysteryStatus) -> (Mystery);
  createMyself: (name: text) -> (Result_15);
  designateSuccessor: (personId: PersonId, priority: nat) -> (Result_14);
  execute: (qJson: text) -> (Result__1) query;
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  getMyAccountId: () -> (Result_13) query;
  getMyAuthMethods: () -> (Result_12) query;
  getMyProfile: () -> (opt PersonProfile) query;
  getMyProfileClaim: (personId: PersonId) -> (opt ProfileClaim) query;
  /// Renders an audit action type variant as its tag text for OQL rows.
  getMyRelationshipRequests: () -> (vec RelationshipRequest) query;
  getPersonProfile: (personId: PersonId) -> (opt PersonProfile) query;
  getProfilePhoto: (personId: PersonId) -> (opt Photo) query;
  getRelationshipRequest: (id: nat) -> (opt RelationshipRequest) query;
  getSingleStewardWarning: () -> (opt text) query;
  isCallerAdmin: () -> (bool) query;
  listApprovedArchiveItems: () -> (vec ArchiveItem) query;
  listApprovedStories: () -> (vec Story) query;
  listArchivedProfileIds: () -> (vec PersonId) query;
  listArchivedProfiles: () -> (vec PersonProfile) query;
  listAuditHistory: () -> (vec AuditEntry) query;
  listConfirmedRelationships: () -> (vec Relationship) query;
  listDuplicateCandidates: () -> (vec DuplicatePair) query;
  listEligibleStewardCandidates: () -> (vec StewardIdentity) query;
  listMysteries: () -> (vec Mystery) query;
  listNotifications: () -> (vec Notification) query;
  listPendingArchiveItems: () -> (vec ArchiveItem) query;
  listPendingMysteryContributions: () -> (vec MysteryContribution) query;
  listPendingStories: () -> (vec Story) query;
  listPersonRelationships: (personId: PersonId) -> (vec Relationship) query;
  listPhotos: (personId: PersonId) -> (vec Photo) query;
  listProfileClaims: () -> (vec ProfileClaim) query;
  listProfileRemovalRequests: () -> (vec ProfileRemovalRequest) query;
  listRelationshipRequests: () -> (vec RelationshipRequest) query;
  listStewardIdentities: () -> (vec StewardIdentity) query;
  listStewards: () -> (vec StewardRecord) query;
  listSuccessors: () -> (vec SuccessorDesignation) query;
  listTimelineEvents: () -> (vec TimelineEvent) query;
  markMysteryResolved: (id: MysteryId, summary: text, supportingEvidence:
   vec text) -> (opt Mystery);
  markNotificationRead: (id: NotificationId) -> (opt Notification);
  mergeProfiles: (canonicalPersonId: PersonId, mergedAwayPersonId:
   PersonId) -> (Result_11);
  notDuplicate: (personIdA: PersonId, personIdB: PersonId) -> (Result_10);
  permanentlyDeleteProfile: (personId: PersonId, confirmation: bool) ->
   (Result_9);
  promoteToSteward: (personId: PersonId) -> (Result_8);
  proposeRelationship: (fromPersonId: PersonId, toPersonId: PersonId,
   relationshipType: RelationshipType) -> (Result_7);
  rejectArchiveItem: (id: ArchiveItemId) -> (opt ArchiveItem);
  rejectProfileClaim: (claimId: nat) -> (opt ProfileClaim);
  rejectProfileRemoval: (requestId: nat) -> (opt ProfileRemovalRequest);
  rejectRelationshipRequest: (requestId: nat) -> (opt RelationshipRequest);
  rejectStory: (id: StoryId) -> (opt Story);
  removeDuplicateProfile: (personId: PersonId) -> (Result_6);
  removePhoto: (personId: PersonId, photoId: PhotoId) -> (bool);
  removeRelationship: (relationshipId: nat) -> (Result_5);
  removeSteward: (stewardAccountId: principal) -> (Result_4);
  requestProfileClaim: (personId: PersonId) -> (Result_3);
  requestProfileRemoval: (personId: PersonId, reason: text) -> (Result_2);
  resolveMergeConflict: (conflictId: nat, canonicalValue: text) ->
   (opt MergeConflict);
  restoreProfile: (personId: PersonId) -> (Result_1);
  reviewMysteryContribution: (id: MysteryContributionId, approve: bool) ->
   (opt MysteryContribution);
  schema: () -> (text) query;
  searchPossibleMatches: (name: text) -> (vec PersonMatch) query;
  setProfilePhoto: (personId: PersonId, photoId: PhotoId) -> (opt Photo);
  setRelationshipRequestPending: (requestId: nat) ->
   (opt RelationshipRequest);
  submitArchiveItem: (title: text, description: text, itemType:
   ArchiveItemType, "blob": ExternalBlob, era: text, year: opt nat, tags:
   vec text, relatedMemberIds: vec text, relatedBranchId: opt text,
   sourceStatus: SourceStatus, privacyLevel: PrivacyLevel, classification:
   ArchiveItemClassification, primarySpeaker: opt OralHistorySpeaker) ->
   (ArchiveItem);
  submitMysteryContribution: (mysteryId: MysteryId, contributionType:
   MysteryContributionType, "text": text) -> (MysteryContribution);
  submitStory: (title: text, storyText: text, relatedMemberIds: vec text,
   era: opt text, year: opt nat, location: opt text, evidenceStatus:
   EvidenceStatus, relatedArchiveItemIds: vec nat) -> (Story);
  updateCanonicalMystery: (id: MysteryId, title: text, description: text,
   relatedMemberIds: vec text, relatedBranchId: opt text, knownFacts:
   vec text, possibilities: vec text, relatedSourceIds: vec nat,
   relatedArchiveItemIds: vec nat, status: MysteryStatus) -> (opt Mystery);
  updateCanonicalStory: (id: StoryId, title: text, storyText: text,
   relatedMemberIds: vec text, era: opt text, year: opt nat, location:
   opt text, evidenceStatus: EvidenceStatus, relatedArchiveItemIds:
   vec nat) -> (opt Story);
  updateOwnProfile: (personId: PersonId, edits: ProfileEdits) -> (Result);
}
