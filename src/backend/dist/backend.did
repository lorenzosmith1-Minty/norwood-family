type RemoveError = 
 variant {
   NotSignedIn;
   ProfileNotFound;
 };
type RemovalError = 
 variant {
   AlreadyPending;
   DeceasedProfile;
   NotOwner;
   NotSignedIn;
   ProfileNotFound;
 };
type RelationshipType = 
 variant {
   Child;
   Parent;
   Sibling;
   SpousePartner;
 };
type RelationshipStatus = 
 variant {
   Confirmed;
   Disputed;
   Pending;
 };
type RelationshipRequestStatus = 
 variant {
   Approved;
   Pending;
   Rejected;
 };
type RelationshipRequest = 
 record {
   id: nat;
   proposedRelationship: RelationshipType;
   relatedPersonId: PersonId;
   requestingPersonId: PersonId;
   reviewedDate: opt int;
   reviewer: opt principal;
   status: RelationshipRequestStatus;
   submittedDate: int;
 };
type RelationshipError = 
 variant {
   DuplicateRequest;
   NotSignedIn;
   PersonNotFound;
 };
type RelationshipAdminError = 
 variant {
   DuplicateRelationship;
   NotSignedIn;
   PersonNotFound;
   RelationshipNotFound;
 };
type Relationship = 
 record {
   fromPersonId: PersonId;
   id: nat;
   relationshipType: RelationshipType;
   status: RelationshipStatus;
   toPersonId: PersonId;
 };
type ProfileRemovalStatus = 
 variant {
   Approved;
   Pending;
   Rejected;
 };
type ProfileRemovalRequest = 
 record {
   id: nat;
