 variant {
   ConfirmationRequired;
   HasApprovedRelationships;
   HasArchiveItems;
   HasMedia;
   HasOwnershipHistory;
   HasTimeline;
   NotSignedIn;
   ProfileNotFound;
 };
type CreateError = variant {NotSignedIn;};
type ClaimStatus = 
 variant {
   Claimed;
   Unclaimed;
 };
type ClaimError = 
 variant {
   AlreadyClaimed;
