 variant {
   Deceased;
   Living;
 };
type ExternalBlob = blob;
type EvidenceStatus = 
 variant {
   Documented;
   FamilyHistory;
   PersonalMemory;
   Unresolved;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type EditError = 
 variant {
   DeceasedProfile;
   NotOwner;
   NotSignedIn;
   ProfileNotFound;
 };
