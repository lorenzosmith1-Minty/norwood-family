type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type TimelineLinkTarget = 
 variant {
   ArchiveItem: nat;
   Mystery: MysteryId;
